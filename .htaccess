DirectoryIndex index.html
# --- www -> apex (self-assessment E2, staged 2026-10-23) ----------------------
# www.mnclockworks.com served a full duplicate of the site. One 301 to the
# https apex, path and query kept. Placed first so it runs before every other rule.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.mnclockworks\.com$ [NC]
  RewriteRule ^ https://mnclockworks.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- Blog pull 2026-10-21 (commits A + C, merged into V2) ---------------------
# Parker approved (1:42 PM CT via Theo); Counsel signed off on the list (1:50 PM CT).
# Unpublished, not deleted: sources hold: true or in site/archive/2026-10-21/; old built,
# legacy and dated copies git mv'd to site/archive/2026-10-21/webroot/. Must stay ABOVE
# every 301/404 rule below (mod_alias: first match wins). client-story is now 410 too
# (Counsel overrode the V2 keep).
RedirectMatch 410 ^/blog/(?:20[0-9]{2}-[0-9]{2}/)?(client-story|lead-response-workflow|truck-cab-ai-playbook|90-day-reflection|competitors-reviews-listening|5-things-ai|chatgpt-prompts|ai-vs-automation|ai-job-replacement|claude-for-email|ai-myths|what-a-pilot-buys|trades-pivot|what-cowork-gets-you|anatomy-of-a-missed-call|2026-outlook|first-season-notes)(\.html|/.*)?$
RedirectMatch 410 ^/docs/calendar-month[0-9]+\.md$
RedirectMatch 410 ^/blog/post\.html$

# --- Redirects (price-fix-2026-10-20) ---------------------------------------
# Merged from the live server .htaccess (Front Desk cutover 2026-09-18; saved copy
# htaccess-live-root.txt, all 49 rules matched live 2026-10-20) and retargeted:
# nothing points at the retired /front-desk.html any more. RedirectMatch covers the
# bare, trailing-slash and deeper variants of each path. No target matches any
# source pattern, so there are no loops. The 23 /blog/*.html rules live in the
# v3-managed block below (same as live).
#
# Retired sections with old prices in git -> home (whole subtree). Live had
# /sniper -> / ; git main had /sniper -> /sitesniper/ (which 301'd to /). Now one hop.
RedirectMatch 301 ^/(learn|sites|sitesniper|sniper|lab|v3|cowork|office)(/.*)?$ /
# Retired admin pages -> home
RedirectMatch 301 ^/(admin|admin-bot)\.html$ /
# Root-level Markdown (SETUP.md and any other *.md at the web root) is internal:
# 404 like /docs. Subfolder .md files (portal/client/legal/*.md) are still served.
RedirectMatch 404 ^/[^/]+\.md$
# Contact: /contact/ is a real page again (2026-10-23). Legacy .html alias only.
RedirectMatch 301 ^/contact\.html$ /contact/
# Server-only Front Desk era pages (not in git, old $247 prices) -> fixed git pages
RedirectMatch 301 ^/front-desk(\.html|/.*)?$ /
RedirectMatch 301 ^/book\.html$ /book/
RedirectMatch 301 ^/about\.html$ /about/
RedirectMatch 301 ^/(pricing|faq)(\.html|/.*)?$ /how-it-works/
RedirectMatch 301 ^/how-it-works\.html$ /how-it-works/
# Script used only by those server-only pages (contains "$247 diagnostic");
# nothing reachable loads it once they redirect.
Redirect gone /js/site.js
# PARKER-DECISION (docs+jsx, Counsel blocker 2026-10-20): internal docs and the raw
# stonearch-ai-site.jsx stay in git but are not served. 404 via the site 404 page.
# (.htaccess rule chosen over the FTP exclude list: it also hides copies already on
# the server, which an exclude would leave in place, and needs no workflow change.)
RedirectMatch 404 ^/docs(/.*)?$
RedirectMatch 404 \.jsx$
# V2 Counsel fixes (2026-10-21). /preview is the legacy preview page: one hop home.
# Source moved to site/archive/2026-10-21/ (not deployed). Nothing deleted.
RedirectMatch 301 ^/preview(/.*)?$ /
# Legacy root terms.html: one hop to the /terms/ page (version and date read from swap-config).
RedirectMatch 301 ^/terms\.html$ /terms/
# Counsel: these two posts are gone (410). Files kept in site/archive/2026-10-21/.
# Other unreviewed posts are staged in BLOG-410-PENDING.md for Parker's keepers call.
RedirectMatch 410 ^/blog/(trades-pivot|what-a-pilot-buys)(\.html|/.*)?$
# Pre-launch (Counsel, 2026-10-21 3:34 AM CT): unlisted posts not yet re-reviewed are gone (410).
# Files stay in place. Reversible: delete a slug from this rule and the post serves again
# (after Sprocket re-reviews it). Covers /blog/<slug>, /blog/<slug>/, /blog/<slug>.html and
# dated aliases such as /blog/2026-06/competitors-reviews-listening.html. client-story stays 200.
RedirectMatch 410 ^/blog/(?:20[0-9]{2}-[0-9]{2}/)?(ai-tools-ranked|cheap-vs-good-ai|competitors-reviews-listening|prompting-101|guide-to-claude|30-day-challenge|what-cowork-gets-you)(\.html|/.*)?$
# Legacy /sprocket page (served 200 locally). File stays; one hop home.
RedirectMatch 301 ^/sprocket(/.*)?$ /
# site/ (Next source + site/archive/) is excluded from the FTP deploy. Belt and braces: never serve it.
RedirectMatch 404 ^/site(/.*)?$
# /what-i-do, /results, /your-own-agent: live sent these to /front-desk.html; the
# fixed git pages now serve them directly, so no rule.
# (2026-10-23: /results/ is its own page again, its 301 to /how-it-works/ removed)

# --- Cache policy -----------------------------------------------------------
# Fixes "Application error: a client-side exception" after a redeploy: without
# this, browsers heuristically cache the HTML, and stale HTML then points at
# _next chunks a later deploy already deleted (404 -> hydration crash).
# HTML always revalidates; content-hashed assets cache for a week.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff|woff2|ttf|otf|svg|png|jpe?g|webp|avif|ico|gif)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
# mod_expires fallback for hosts without mod_headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Privacy: public privacy page now points at the portal Privacy Notice v2.0 (Counsel audit #14, 2026-10-20)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # V2: pattern also matches "privacy.html/", which is what /privacy/ becomes when
  # MultiViews is on (it 404'd before). NE keeps the # unescaped. Tested with MultiViews on and off.
  RewriteRule ^privacy(\.html)?/?$ /portal/client/#/privacy-notice [R=301,NE,L]
</IfModule>

