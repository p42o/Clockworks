# mnclockworks.com root .htaccess
# Merged 2026-10-18: live server copy (Front Desk cutover 2026-09-18, sha256 90267e45...)
# + repo rules. Hand-maintained sections above; the v3-managed block at the end
# (ErrorDocument 404, /resources.html, legacy blog 301s) is regenerated by
# site/scripts/sync-out.mjs on `npm run export:root`. api/ protections live in api/.htaccess.

DirectoryIndex index.html

# --- Cache policy -----------------------------------------------------------
# Fixes "Application error: a client-side exception" after a redeploy: without
# this, browsers heuristically cache the HTML, and stale HTML then points at
# _next chunks a later deploy already deleted (404 -> hydration crash).
# HTML always revalidates; content-hashed assets cache for a week.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff|woff2|ttf|otf|svg|png|jpe?g|webp|avif|ico|gif)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
# mod_expires fallback for hosts without mod_headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Front Desk retired 2026-10-18 (NAP audit #6): no redirects to /front-desk.html. Do not re-add.
Redirect 301 /front-desk.html /

# --- Retired SKU / coffee-bet era paths (from live 2026-09-18 cutover) -----
# Front Desk retired 2026-10-18: former "-> /front-desk.html" targets retargeted to "/".
# These paths stay redirected to preserve live behavior (Theo to decide on un-redirecting).
# Trailing-slash form listed FIRST: mod_alias is first-match + prefix, so a bare
# "/results" rule above "/results/" would send /results/ to "//" on stock Apache.
Redirect 301 /what-i-do/ /
Redirect 301 /what-i-do /
Redirect 301 /cowork/ /
Redirect 301 /cowork /
Redirect 301 /your-own-agent/ /
Redirect 301 /your-own-agent /
Redirect 301 /results/ /
Redirect 301 /results /
Redirect 301 /learn/ /
Redirect 301 /learn /
Redirect 301 /sites/ /
Redirect 301 /sites /
Redirect 301 /sitesniper/ /
Redirect 301 /sitesniper /
Redirect 301 /sniper/ /
Redirect 301 /sniper /
Redirect 301 /office/ /
Redirect 301 /office /
Redirect 301 /lab/ /
Redirect 301 /lab /
Redirect 301 /v3/ /
Redirect 301 /v3 /
Redirect 301 /resources.html /blog/
Redirect 301 /contact/ /book/
Redirect 301 /contact /book/
Redirect 301 /admin.html /
Redirect 301 /admin-bot.html /
# (Old repo rule /sniper -> /sitesniper/ dropped: live sends both /sniper and /sitesniper to /.)

# BEGIN v3-managed (auto-generated by sync-out.mjs — edit there, not here)
ErrorDocument 404 /404.html
Redirect 301 /resources.html /blog/
