# Root .htaccess for mnclockworks.com.
# Based on the LIVE server file (saved 2026-10-18; all 49 live 301s re-verified with
# curl on 2026-10-21 ~1:55 PM CT), not on the older git copy, so a deploy of this
# branch changes only the blog-pull behaviour below. The 22 legacy /blog/*.html 301s
# now come only from the sync-out managed block at the bottom (held posts skipped).
# Clockworks Front Desk cutover — 2026-09-18
# Preserves blog/media/images. Redirects retired SKU paths.

DirectoryIndex index.html

# --- Cache policy (from prior live .htaccess) -------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff|woff2|ttf|otf|svg|png|jpe?g|webp|avif|ico|gif)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

ErrorDocument 404 /404.html

# --- Blog pull 2026-10-21 (410 Gone) ---------------------------------------
# Parker approved (1:42 PM CT via Theo); Counsel signed off on the list (1:50 PM CT).
# Pulled posts are unpublished, not deleted: sources carry hold: true and the old
# built/legacy/dated copies were git mv'd to site/archive/2026-10-21/webroot/blog/.
# Matches /blog/<slug>, /blog/<slug>/..., /blog/<slug>.html and /blog/2026-0X/<slug>.html.
# Must stay ABOVE every Redirect 301 /blog/... line (mod_alias: first match wins).
RedirectMatch 410 ^/blog/(?:20[0-9]{2}-[0-9]{2}/)?(client-story|lead-response-workflow|truck-cab-ai-playbook|90-day-reflection|competitors-reviews-listening|5-things-ai|chatgpt-prompts|ai-vs-automation|ai-job-replacement|claude-for-email|ai-myths|what-a-pilot-buys|trades-pivot|what-cowork-gets-you|anatomy-of-a-missed-call|2026-outlook|first-season-notes)(\.html|/.*)?$

# --- Retired SKU / coffee-bet era paths → Front Desk or home ---------------
# Prefer Front Desk product page for agent/office SKUs; home for generic dead ends.
Redirect 301 /what-i-do /front-desk.html
Redirect 301 /what-i-do/ /front-desk.html
Redirect 301 /cowork /front-desk.html
Redirect 301 /cowork/ /front-desk.html
Redirect 301 /your-own-agent /front-desk.html
Redirect 301 /your-own-agent/ /front-desk.html
Redirect 301 /results /front-desk.html
Redirect 301 /results/ /front-desk.html
Redirect 301 /learn /
Redirect 301 /learn/ /
Redirect 301 /sites /
Redirect 301 /sites/ /
Redirect 301 /sitesniper /
Redirect 301 /sitesniper/ /
Redirect 301 /sniper /
Redirect 301 /sniper/ /
Redirect 301 /office /front-desk.html
Redirect 301 /office/ /front-desk.html
Redirect 301 /lab /
Redirect 301 /lab/ /
Redirect 301 /v3 /
Redirect 301 /v3/ /
Redirect 301 /resources.html /blog/
Redirect 301 /contact /book.html
Redirect 301 /contact/ /book.html
Redirect 301 /admin.html /
Redirect 301 /admin-bot.html /

# BEGIN v3-managed (auto-generated by sync-out.mjs — edit there, not here)
ErrorDocument 404 /404.html
Redirect 301 /resources.html /blog/
Redirect 301 /blog/30-day-challenge.html /blog/30-day-challenge/
Redirect 301 /blog/2026-05/5-ai-tools-small-business-2026.html /blog/5-ai-tools-small-business-2026/
Redirect 301 /blog/ai-tools-ranked.html /blog/ai-tools-ranked/
Redirect 301 /blog/2026-06/anatomy-of-a-context-vault.html /blog/anatomy-of-a-context-vault/
Redirect 301 /blog/cheap-vs-good-ai.html /blog/cheap-vs-good-ai/
Redirect 301 /blog/email-triage-tip.html /blog/email-triage-tip/
Redirect 301 /blog/guide-to-claude.html /blog/guide-to-claude/
Redirect 301 /blog/prompting-101.html /blog/prompting-101/
Redirect 301 /blog/2026-05/your-ai-doesnt-know-you.html /blog/your-ai-doesnt-know-you/
# END v3-managed
