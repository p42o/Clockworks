Options -Indexes
<FilesMatch "^_|\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Keep _cache denied in case a stale folder remains on the host.
  RewriteRule ^(?:_cache|tests)(?:/|$) - [F,L,NC]
</IfModule>
<IfModule mod_headers.c>
  <Files "reviews.php">
    Header always set Cache-Control "no-store"
  </Files>
</IfModule>
<IfModule mod_expires.c>
  <Files "reviews.php">
    ExpiresActive Off
  </Files>
</IfModule>
