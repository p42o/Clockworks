# Internal admin-only page (Timely deploy prompt). Not linked anywhere, not in the sitemap.
# Everything under here goes through gate.php: admin PIN only (shared TIMELY_ADMIN_HMAC from
# timely/_config.php), page decrypted from blob/ with TIMELY_KEY. No client/viewer PIN.
Options -Indexes
DirectoryIndex gate.php

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

<FilesMatch "^(_config\.php|.*\.bin|.*\.json|.*\.md|.*\.txt)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /internal/timely-deploy/
RewriteRule ^_state(/|$) - [F,L]
RewriteRule ^gate\.php$ - [L]
RewriteRule ^(.*)$ gate.php?p=$1 [L,QSA]
